{
  "rewrites": [
    {
      "source": "/api/:action(send-workshop-reminders|send-workshop-feedback|send-workshop-message|drive-upload)",
      "destination": "/api/workshop?action=:action"
    },
    {
      "source": "/api/send-weekly-report",
      "destination": "/api/send-daily-report?period=weekly"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/send-followup-reminders",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/send-daily-report",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/send-weekly-report",
      "schedule": "30 12 * * 6"
    },
    {
      "path": "/api/send-allocation-summary",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/deactivate-inactive-partners",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/send-birthday-messages",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/send-workshop-reminders",
      "schedule": "30 4 * * *"
    }
  ],
  "functions": {
    "api/send-daily-report.js": {
      "maxDuration": 30
    },
    "api/send-allocation-summary.js": {
      "maxDuration": 30
    },
    "api/deactivate-inactive-partners.js": {
      "maxDuration": 60
    },
    "api/send-birthday-messages.js": {
      "maxDuration": 60
    },
    "api/workshop.js": {
      "maxDuration": 60
    }
  }
}
